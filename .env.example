# Shared FinAssist local development configuration.
# Create a real .env file beside this template. Never commit it.

# Preferred database for shared chats and IR evidence.
DATABASE_URL=mysql+pymysql://finassist_app:replace_with_your_password@localhost:3306/finassist_ai

# Information Retrieval Agent key. Never paste a real key in GitHub or chat.
TAVILY_API_KEY=

# Optional trusted source customization for Tavily.
TAVILY_INCLUDE_DOMAINS=cbsl.gov.lk,sec.gov.lk,cse.lk,consumerfinance.gov,investor.gov,federalreserve.gov,imf.org,worldbank.org
TAVILY_SEARCH_DEPTH=basic

# Direct HTTPS avoids stale local proxy variables. Set true only when your
# deployment deliberately requires its configured HTTP(S) proxy.
TAVILY_USE_SYSTEM_PROXY=false

# Mahee's evidence-grounded Risk Analysis Agent. Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Set true only when deployment intentionally requires HTTP(S) proxy settings.
GEMINI_USE_SYSTEM_PROXY=false

# Authentication & Security
JWT_SECRET_KEY=replace_with_a_secure_random_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google OAuth 2.0 Web Client ID for user authentication. This ID is public;
# do not add a Google client secret to the frontend or this file.
GOOGLE_CLIENT_ID=replace_with_your_google_client_id
