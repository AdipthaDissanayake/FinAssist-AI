# Shared FinAssist local development configuration.
# Create a real .env file beside this template. Never commit it.

# Preferred database for shared chats and IR evidence.
DATABASE_URL=mysql+pymysql://finassist_app:replace_with_your_password@localhost:3306/finassist_ai

# Information Retrieval Agent key. Never paste a real key in GitHub or chat.
TAVILY_API_KEY=

# Optional trusted source customization for Tavily.
TAVILY_INCLUDE_DOMAINS=cbsl.gov.lk,sec.gov.lk,cse.lk,consumerfinance.gov,investor.gov,federalreserve.gov,imf.org,worldbank.org
TAVILY_SEARCH_DEPTH=basic
