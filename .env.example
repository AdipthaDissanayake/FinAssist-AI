# ==============================================================================
# FinAssist AI - Environment Configuration Template
# Copy this file to `.env` in the project root and provide your actual values.
# NEVER commit your `.env` file containing real credentials to version control.
# ==============================================================================

# Database Connection (MySQL / MariaDB or SQLite)
# Example: mysql+pymysql://username:password@localhost:3306/finassist_ai
DATABASE_URL=mysql+pymysql://finassist_app:your_password@localhost:3306/finassist_ai

# Google Gemini API Key (Required for Risk Analysis Agent)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily Search API Key (Required for Information Retrieval Agent)
# Obtain from: https://tavily.com
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# Google OAuth 2.0 Client ID (Required for Google Sign-In)
# Public Web Client ID from Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# JWT Secret Key for Session Signing
# Generate a secure 256-bit random key using: openssl rand -hex 32
# (or in Python: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET_KEY=generate_a_secure_random_jwt_secret_key_at_least_32_chars

# Optional Settings
# GEMINI_MODEL=gemini-2.5-flash
# APP_ENV=development
