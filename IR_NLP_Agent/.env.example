# Copy these variable names into your local environment or a private .env file.
# Never commit a real API key to GitHub.
GEMINI_API_KEY=
# Needed only for --engine gemini-search (paid Google Search grounding).
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional budget cap for --engine antigravity.
ANTIGRAVITY_MAX_TOTAL_TOKENS=16000
# Primary source-based retrieval engine. Never commit a real key.
TAVILY_API_KEY=
# Optional comma-separated approved domains. Defaults include CBSL, SEC Sri Lanka,
# CSE, CFPB, Investor.gov, Federal Reserve, IMF, and World Bank.
TAVILY_INCLUDE_DOMAINS=
TAVILY_SEARCH_DEPTH=basic
